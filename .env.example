# ─── Supabase ────────────────────────────────────────────────────────────────
# Públicas (cliente). Seguras de exponer; la seguridad real vive en RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Privada (solo servidor: Server Actions, route handlers, jobs de ingesta).
# NUNCA debe filtrarse al cliente. Bypassa RLS — usar con cuidado.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=San Fernando del Valle de Catamarca
NEXT_PUBLIC_MAP_CENTER_LAT=-28.4696
NEXT_PUBLIC_MAP_CENTER_LNG=-65.7795

# ─── Email / Resend ──────────────────────────────────────────────────────────
# Si no se configuran, las notificaciones de ingesta se omiten silenciosamente.
RESEND_API_KEY=re_...
# Dirección remitente. En dev usar onboarding@resend.dev (sin verificar dominio).
# En producción, usar un dominio verificado en Resend.
RESEND_FROM=onboarding@resend.dev
# Email del administrador que recibe las alertas de ingesta.
ADMIN_EMAIL=admin@ejemplo.com

# ─── Tests de integración ────────────────────────────────────────────────────
# Usadas por `pnpm test:integration` en @haku/core y @haku/events.
# Crear `.env.test.local` (gitignored) con los valores de `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY ya definida arriba; se reutiliza en los tests.

# ─── Módulo Events (ingesta) ─────────────────────────────────────────────────
# Token simple para proteger el endpoint de disparo de ingesta (cron / manual).
EVENTS_INGEST_TOKEN=replace-with-random-secret
# User-Agent identificable para el scraper (buena práctica de scraping cortés).
EVENTS_SCRAPER_USER_AGENT=HakuBot/0.1 (+https://haku.app)
