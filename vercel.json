{
  "buildCommand": "pnpm run build",
  "outputDirectory": "web/.next",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/events/ingest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 6 */4 * *"
    }
  ]
}
